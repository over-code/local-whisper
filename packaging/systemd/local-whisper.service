[Unit]
Description=Local Whisper dictation daemon
Documentation=https://github.com/over-code/local-whisper
# Wait for the graphical session: the daemon needs a display and a tray.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/local-whisper daemon
Restart=on-failure
RestartSec=5
# The Whisper model is the memory hog; give the service room but not the moon.
MemoryHigh=6G
Nice=-5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
